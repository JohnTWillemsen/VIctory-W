+                stage: "compute",
+                hash: hash.to_owned(),
+                container: Vec::new(),
+                #[cfg(windows)]
+                ambient: None,
+                #[cfg(windows)]
+                translated: OnceLock::new(),
+            })
+        };
+        let head = Pending::new(vec![shader(HEAD_BLEND_SHAPE_MAP)], None);
+        assert!(head.scene_input && head.screen, "made at creation, with the screen passes' budget");
